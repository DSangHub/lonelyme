# =============================================================================
# LonelyMe SANDBOX — copy to .env.local for local development
# =============================================================================
# cp env.sandbox.local .env.local
#
# Requires: Docker + Supabase CLI for local Supabase
#   npm run sandbox:start
# =============================================================================

# --- Sandbox flags ---
SANDBOX_MODE=true
NEXT_PUBLIC_SANDBOX_MODE=true

# --- Supabase LOCAL (default keys from `supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qkqsvr92yHHfAktuTF8FY

# --- Stripe MOCK (instant token credit, no real payment) ---
STRIPE_MODE=mock
NEXT_PUBLIC_STRIPE_MODE=mock
# Leave empty for mock mode, or add test keys for real Stripe test checkout:
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER_5=price_...
# STRIPE_PRICE_STARTER_10=price_...

# --- Translation & Moderation MOCK (no API keys needed) ---
TRANSLATION_PROVIDER=mock
MODERATION_PROVIDER=mock

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
