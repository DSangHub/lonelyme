# =============================================================================
# LonelyMe — Supabase CLOUD test project (alternative to local)
# =============================================================================
# Use this if you don't have Docker. Create a free project at supabase.com
# Run supabase/schema.sql in SQL Editor, then fill in your keys below.
# =============================================================================

SANDBOX_MODE=true
NEXT_PUBLIC_SANDBOX_MODE=true

# --- Supabase CLOUD (replace with your test project keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe TEST mode ---
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PRICE_STARTER_5=price_YOUR_5_DOLLAR_PACK
STRIPE_PRICE_STARTER_10=price_YOUR_10_DOLLAR_PACK

# --- Mock translation (no Gemini/DeepL keys needed) ---
TRANSLATION_PROVIDER=mock
MODERATION_PROVIDER=mock

NEXT_PUBLIC_APP_URL=http://localhost:3000
